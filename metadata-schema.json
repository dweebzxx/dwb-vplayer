{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Assistant Workflow Metadata Schema",
  "description": "Required metadata fields for dwb player AI assistant workflow reports.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "pass_id",
    "pass_name",
    "date",
    "model",
    "status",
    "workflow_guide_version",
    "agent_md_present",
    "agent_md_authorized",
    "agent_md_authority",
    "agent_md_maintenance_score",
    "schema_present",
    "gitignore_correct",
    "prompt_saved",
    "launcher_saved",
    "build_result",
    "files_read",
    "files_created",
    "files_modified",
    "pre_existing_dirty_files",
    "validation",
    "version_bumped",
    "committed",
    "pushed",
    "manual_verification_required",
    "report_path",
    "duration_seconds",
    "total_tokens_used"
  ],
  "properties": {
    "pass_id": {
      "type": "string",
      "minLength": 1
    },
    "pass_name": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "BUILD_SUCCEEDED",
        "BUILD_FAILED",
        "DOCUMENTATION_ONLY",
        "WORKFLOW_ONLY",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "workflow_guide_version": {
      "type": "string",
      "minLength": 1
    },
    "agent_md_present": {
      "type": "boolean"
    },
    "agent_md_authorized": {
      "type": "boolean"
    },
    "agent_md_authority": {
      "type": "string",
      "enum": [
        "created_by_p01_bootstrap",
        "accepted_by_p01_adoption_bootstrap",
        "accepted_by_remediation_pass",
        "not_present",
        "unknown"
      ]
    },
    "agent_md_maintenance_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "schema_present": {
      "type": "boolean"
    },
    "gitignore_correct": {
      "type": "boolean"
    },
    "prompt_saved": {
      "type": "boolean"
    },
    "launcher_saved": {
      "type": "boolean"
    },
    "build_result": {
      "type": [
        "object",
        "null"
      ]
    },
    "files_read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_created": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_modified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pre_existing_dirty_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version_bumped": {
      "type": "boolean"
    },
    "committed": {
      "type": "boolean"
    },
    "pushed": {
      "type": "boolean"
    },
    "manual_verification_required": {
      "type": "boolean"
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    },
    "duration_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_tokens_used": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
